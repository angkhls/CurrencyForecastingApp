# SQLite по умолчанию (не нужен Docker)
STORAGE=sqlite
SQLITE_PATH=./data/currency.db

# Или PostgreSQL:
# STORAGE=postgres
# DATABASE_URL=postgresql://currency_user:currency_pass@localhost:5432/currencydb

# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
